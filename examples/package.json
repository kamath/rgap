{
  "name": "@rgap/examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:ci-workspaces": "pnpm --filter '!./apps/**' --recursive --if-present build",
    "invariants": "tsx invariants.ts",
    "mcp-proxy": "tsx mcp-proxy/index.ts",
    "secret-store": "tsx secret-store/index.ts",
    "prestart": "pnpm --filter @rgap/server generate",
    "start": "tsx index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@hono/node-server": "^2.1.1",
    "@rgap/core": "workspace:*",
    "@rgap/local-credential-store": "workspace:*",
    "@rgap/local-oauth-flow-store": "workspace:*",
    "@rgap/mcp-proxy": "workspace:*",
    "@rgap/mcp-proxy-client": "workspace:*",
    "@rgap/postgres": "workspace:*",
    "@rgap/server": "workspace:*",
    "@rgap/sqlite": "workspace:*",
    "ai": "^7.0.77",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
